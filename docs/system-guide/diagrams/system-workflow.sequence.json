{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "管理员与参与者双端联动闭环",
    "locale": "zh-CN",
    "output": "apps/admin-web/public/system-guide/diagrams/system-workflow.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1500, 700],
    "views": [
      {
        "id": "publish-and-assign",
        "label": "发布与分配",
        "focus": ["admin-web", "control-plane", "postgres"],
        "note": "Admin 发布不可变 TaskVersion，并创建 Participant Assignment。"
      },
      {
        "id": "record-and-upload",
        "label": "Session 与直传",
        "focus": ["participant-web", "control-plane", "private-storage"],
        "note": "Participant 确认任务、创建 Recording Session，并通过 TUS 直传视频。"
      },
      {
        "id": "verify-and-review",
        "label": "对账与审核",
        "focus": ["private-storage", "control-plane", "postgres", "admin-web"],
        "note": "对象核验、Match、Review 与 Audit 汇合为可追溯闭环。"
      }
    ]
  },
  "participants": [
    {
      "id": "admin-web",
      "type": "frontend",
      "label": "Admin Web"
    },
    {
      "id": "control-plane",
      "type": "backend",
      "label": "控制面服务"
    },
    {
      "id": "postgres",
      "type": "database",
      "label": "PostgreSQL"
    },
    {
      "id": "participant-web",
      "type": "frontend",
      "label": "Participant Web"
    },
    {
      "id": "private-storage",
      "type": "cloud",
      "label": "私有对象存储"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 218,
      "label": "发布与分配"
    },
    {
      "from": 226,
      "to": 322,
      "label": "参与者确认与 Recording Session"
    },
    {
      "from": 330,
      "to": 452,
      "label": "UploadAttempt 与 TUS 直传"
    },
    {
      "from": 460,
      "to": 620,
      "label": "对账、Review 与 Audit"
    }
  ],
  "messages": [
    {
      "id": "admin-publish-assignment",
      "from": "admin-web",
      "to": "control-plane",
      "y": 170,
      "label": "发布 TaskVersion + 创建 Assignment",
      "variant": "emphasis"
    },
    {
      "id": "control-persist-assignment",
      "from": "control-plane",
      "to": "postgres",
      "y": 202,
      "label": "追加不可变版本、分配与 AuditEvent",
      "variant": "emphasis"
    },
    {
      "id": "participant-create-session",
      "from": "participant-web",
      "to": "control-plane",
      "y": 240,
      "label": "确认 TaskVersion + 创建 RecordingSession"
    },
    {
      "id": "control-verify-session-authority",
      "from": "control-plane",
      "to": "postgres",
      "y": 272,
      "label": "校验 Assignment / Device / Consent；追加 Session"
    },
    {
      "id": "control-return-marker",
      "from": "control-plane",
      "to": "participant-web",
      "y": 304,
      "label": "返回 Session + 签名 Marker",
      "variant": "return"
    },
    {
      "id": "participant-create-attempt",
      "from": "participant-web",
      "to": "control-plane",
      "y": 344,
      "label": "手动选择 Session；创建 UploadAttempt"
    },
    {
      "id": "control-return-upload-grant",
      "from": "control-plane",
      "to": "participant-web",
      "y": 376,
      "label": "持久化 object key；返回短期 TUS 授权",
      "variant": "security"
    },
    {
      "id": "participant-upload-bytes",
      "from": "participant-web",
      "to": "private-storage",
      "y": 408,
      "label": "TUS 分片直传视频字节",
      "variant": "emphasis",
      "note": "视频请求体不经过 Next.js / Vercel Function"
    },
    {
      "id": "participant-request-complete",
      "from": "participant-web",
      "to": "control-plane",
      "y": 440,
      "label": "Complete：请求对账（非完成证明）"
    },
    {
      "id": "control-verify-object",
      "from": "control-plane",
      "to": "private-storage",
      "y": 472,
      "label": "HEAD / Range：核验对象与轻量 metadata"
    },
    {
      "id": "control-persist-validation",
      "from": "control-plane",
      "to": "postgres",
      "y": 504,
      "label": "追加 VideoAsset、Validation / Match / Review",
      "variant": "emphasis"
    },
    {
      "id": "admin-submit-review",
      "from": "admin-web",
      "to": "control-plane",
      "y": 544,
      "label": "ReviewCase：Confirm / Correct + Reason"
    },
    {
      "id": "control-append-decision",
      "from": "control-plane",
      "to": "postgres",
      "y": 576,
      "label": "追加 superseding MatchDecision + AuditEvent",
      "variant": "emphasis"
    },
    {
      "id": "control-return-evidence",
      "from": "control-plane",
      "to": "admin-web",
      "y": 608,
      "label": "返回新旧决定链与审计证据",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "同一权威联动",
      "items": [
        "Admin 发布与分配，Participant 在授权范围内确认、建 Session 与上传。"
      ]
    },
    {
      "dot": "emerald",
      "title": "控制面 / 数据面分离",
      "items": [
        "视频字节直达私有 Storage；Complete 只启动对象与 metadata 对账。"
      ]
    },
    {
      "dot": "violet",
      "title": "不可变审核闭环",
      "items": [
        "人工纠正新增 MatchDecision 并 supersede 旧决定，关键动作追加 AuditEvent。"
      ]
    }
  ]
}
