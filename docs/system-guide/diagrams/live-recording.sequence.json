    "views": [
      {
        "id": "authorize-broadcast",
        "label": "创建与授权",
        "focus": ["capture-web", "control-plane", "postgres", "provider-adapter", "amazon-ivs"],
        "note": "内部 LiveCapture 先落库，再通过适配器获取短期、受限推流授权。"
      },
      {
        "id": "stream-and-record",
        "label": "推流与自动录制",
        "focus": ["capture-web", "amazon-ivs", "private-s3", "provider-adapter", "control-plane"],
        "note": "IVS 接收直播并自动录制到私有 S3；回调需要认证、去重与对账。"
      },
      {
        "id": "admin-playback",
        "label": "管理端状态与回看",
        "focus": ["admin-web", "control-plane", "postgres", "private-s3"],
        "note": "管理端读取内部权威状态，并通过短期受控播放授权回看归档。"
      }
    ]
  },
