{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "未来方案：S3 Multipart 跨天断点续传",
    "locale": "zh-CN",
    "output": "apps/admin-web/public/system-guide/diagrams/multipart-resume.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1500, 750],
    "views": [
      {
        "id": "multipart-init",
        "label": "初始化与首批分片",
        "focus": ["participant", "participant-web", "upload-control", "postgres", "object-storage"],
        "note": "业务 UploadAttempt 持有 provider uploadId、校验合同与分片回执。"
      },
      {
        "id": "multipart-resume",
        "label": "暂停与恢复",
        "focus": ["participant", "participant-web", "upload-control", "object-storage"],
        "note": "恢复同一 uploadId，只补签并上传缺失分片。"
      },
      {
        "id": "multipart-complete",
        "label": "合并与二次核验",
        "focus": ["participant-web", "upload-control", "postgres", "object-storage"],
        "note": "CompleteMultipartUpload 后仍需 HeadObject、大小与 checksum 对账。"
      }
    ]
  },
  "participants": [
    {
      "id": "participant",
      "type": "external",
      "label": "参与者"
    },
    {
      "id": "participant-web",
      "type": "frontend",
      "label": "上传客户端"
    },
    {
      "id": "upload-control",
      "type": "backend",
      "label": "上传控制面"
    },
    {
      "id": "postgres",
      "type": "database",
      "label": "PostgreSQL"
    },
    {
      "id": "object-storage",
      "type": "cloud",
      "label": "S3 兼容存储"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 366,
      "label": "初始化与首批分片"
    },
    {
      "from": 374,
      "to": 548,
      "label": "跨天恢复与缺片补传"
    },
    {
      "from": 556,
      "to": 662,
      "label": "合并、核验与过期清理"
    }
  ],
  "messages": [
    {
      "id": "participant-select-file",
      "from": "participant",
      "to": "participant-web",
      "y": 170,
      "label": "选择文件；计算流式 fingerprint / checksum"
    },
    {
      "id": "client-create-upload-attempt",
      "from": "participant-web",
      "to": "upload-control",
      "y": 200,
      "label": "创建业务 UploadAttempt",
      "variant": "emphasis"
    },
    {
      "id": "control-create-multipart",
      "from": "upload-control",
      "to": "object-storage",
      "y": 230,
      "label": "CreateMultipartUpload（接收 provider uploadId）"
    },
    {
      "id": "control-persist-upload-id",
      "from": "upload-control",
      "to": "postgres",
      "y": 260,
      "label": "持久化 uploadId、region、expiry 与 checksum contract",
      "variant": "emphasis"
    },
    {
      "id": "control-sign-first-parts",
      "from": "upload-control",
      "to": "participant-web",
      "y": 290,
      "label": "返回所需 part 的短期 presigned URL",
      "variant": "security"
    },
    {
      "id": "client-upload-first-parts",
      "from": "participant-web",
      "to": "object-storage",
      "y": 320,
      "label": "并发 PUT parts（有界重试）",
      "variant": "emphasis"
    },
    {
      "id": "client-submit-part-receipts",
      "from": "participant-web",
      "to": "upload-control",
      "y": 350,
      "label": "幂等提交 partNumber + size + ETag / checksum"
    },
    {
      "id": "participant-reselects-file",
      "from": "participant",
      "to": "participant-web",
      "y": 390,
      "label": "暂停 / 断网；跨天重选原文件并校验 fingerprint",
      "variant": "dashed"
    },
    {
      "id": "client-resume-attempt",
      "from": "participant-web",
      "to": "upload-control",
      "y": 420,
      "label": "恢复同一 UploadAttempt / uploadId",
      "variant": "emphasis"
    },
    {
      "id": "control-list-provider-parts",
      "from": "upload-control",
      "to": "object-storage",
      "y": 450,
      "label": "ListParts：读取 provider 已接收分片"
    },
    {
      "id": "control-reconcile-manifest",
      "from": "upload-control",
      "to": "postgres",
      "y": 480,
      "label": "对账应用 manifest 与 provider receipts"
    },
    {
      "id": "control-resign-missing-parts",
      "from": "upload-control",
      "to": "participant-web",
      "y": 510,
      "label": "只为缺失 part 补签；不创建新 uploadId",
      "variant": "security"
    },
    {
      "id": "client-upload-missing-parts",
      "from": "participant-web",
      "to": "object-storage",
      "y": 538,
      "label": "PUT 缺失 parts；回执幂等重放",
      "variant": "emphasis"
    },
    {
      "id": "client-complete-manifest",
      "from": "participant-web",
      "to": "upload-control",
      "y": 570,
      "label": "提交有序完成 manifest"
    },
    {
      "id": "control-complete-and-verify",
      "from": "upload-control",
      "to": "object-storage",
      "y": 600,
      "label": "CompleteMultipartUpload + HeadObject / checksum 核验",
      "variant": "emphasis"
    },
    {
      "id": "control-finalize-video-asset",
      "from": "upload-control",
      "to": "postgres",
      "y": 630,
      "label": "登记 StoredObject / VideoAsset 与 completion receipt",
      "variant": "emphasis"
    },
    {
      "id": "control-abort-expired",
      "from": "upload-control",
      "to": "object-storage",
      "y": 660,
      "label": "过期 / 放弃：Abort + 生命周期清理残留 parts",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "未来方案，尚未接入",
      "items": [
        "当前 MVP 仍使用 TUS；本图描述生产级数 GB / 跨天上传的演进路径。"
      ]
    },
    {
      "dot": "cyan",
      "title": "恢复同一 provider 会话",
      "items": [
        "ListParts 只做对账，只补签缺失 part；重复回执按 UploadAttempt 幂等合并。"
      ]
    },
    {
      "dot": "emerald",
      "title": "Complete 后仍需核验",
      "items": [
        "Multipart ETag 不是通用完整文件哈希；完成后仍核对 key、size、checksum 与 receipt。"
      ]
    }
  ]
}
