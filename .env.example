# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_STORAGE_TUS_ENDPOINT=http://127.0.0.1:54321/storage/v1/upload/resumable

# Server-only settings
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWT_SECRET=replace-with-local-jwt-secret
STORAGE_UPLOAD_AUTH_MODE=nas_scoped_jwt
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PARTICIPANT_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
# Set a distinct value in each Vercel project.
AUTH_COOKIE_NAME=egocapture-participant-auth
MARKER_PRIVATE_KEY_JWK={}
MARKER_PUBLIC_KEY_JWK={}
MARKER_KEY_ID=marker-key-v1
DEVICE_SERIAL_HMAC_KEY=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin.demo@egocapture.invalid
DEMO_ADMIN_PASSWORD=replace-with-demo-password
DEMO_PARTICIPANT_PASSWORD=replace-with-demo-password

# Development topology. Fresh clones use local Docker.
EGOCAPTURE_DEV_PROFILE=local
NAS_SSH_HOST=your-nas-ssh-alias
NAS_REMOTE_ROOT=/vol1/your-user/work/video-data-collection/current
NAS_API_PORT=56521
NAS_DB_PORT=56522
