{
  "name": "egocapture",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev-infra.ts dev",
    "dev:web": "pnpm --parallel --filter @egocapture/participant-web --filter @egocapture/admin-web dev",
    "dev:local": "tsx scripts/dev-infra.ts local:dev",
    "dev:local:setup": "tsx scripts/dev-infra.ts local:setup",
    "dev:local:infra": "tsx scripts/dev-infra.ts local:infra",
    "dev:local:migrate": "tsx scripts/dev-infra.ts local:migrate",
    "dev:local:seed": "tsx scripts/dev-infra.ts local:seed",
    "dev:local:down": "tsx scripts/dev-infra.ts local:down",
    "dev:local:destroy": "tsx scripts/dev-infra.ts local:destroy",
    "dev:nas": "tsx scripts/dev-infra.ts nas:dev",
    "dev:nas:setup": "tsx scripts/dev-infra.ts nas:setup",
    "dev:nas:infra": "tsx scripts/dev-infra.ts nas:infra",
    "dev:nas:tunnel": "tsx scripts/dev-infra.ts nas:tunnel",
    "dev:nas:check": "tsx scripts/dev-infra.ts nas:check",
    "dev:nas:migrate": "tsx scripts/dev-infra.ts nas:migrate",
    "dev:nas:seed": "tsx scripts/dev-infra.ts nas:seed",
    "dev:nas:down": "tsx scripts/dev-infra.ts nas:down",
    "dev:nas:destroy": "tsx scripts/dev-infra.ts nas:destroy",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:status": "tsx scripts/database.ts status",
    "db:verify": "tsx scripts/database.ts verify",
    "db:demo:refresh": "tsx scripts/demo-refresh.ts",
    "db:reset:task-v2": "tsx scripts/reset-task-data.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:test:seed": "tsx scripts/seed-check.ts",
    "db:test:rls": "tsx scripts/rls-check.ts",
    "auth:test": "tsx scripts/auth-check.ts",
    "participant:test": "tsx scripts/participant-check.ts",
    "task:test": "tsx scripts/task-check.ts",
    "session:test": "tsx scripts/session-check.ts",
    "upload:test": "tsx scripts/upload-check.ts",
    "review:test": "tsx scripts/review-check.ts",
    "cron:test": "tsx scripts/cron-check.ts",
    "repo:safety": "tsx scripts/repository-safety.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "build": "pnpm --filter @egocapture/participant-web build && pnpm --filter @egocapture/admin-web build",
    "start": "pnpm --parallel --filter @egocapture/participant-web --filter @egocapture/admin-web start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @egocapture/participant-web typecheck && pnpm --filter @egocapture/admin-web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "PUBLIC_ACCEPTANCE=1 playwright test --project=chromium tests/e2e/public-deployment.spec.ts tests/e2e/main-flow.spec.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@egocapture/core": "workspace:*",
    "@egocapture/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.1",
    "jose": "6.2.10",
    "mediainfo.js": "0.3.7",
    "mp4box": "2.4.1",
    "next": "16.3.4",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "tus-js-client": "4.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.12",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
